# =============================================================================
# JANSAHAYA V2 — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# COPY THIS FILE TO .env OR .env.local FOR LOCAL DEVELOPMENT.
# NEVER COMMIT REAL SECRETS OR CREDENTIALS TO THE REPOSITORY.
# IN PRODUCTION, INJECT SECRETS VIA RUNTIME ENVIRONMENT / SECRETS MANAGER.
# =============================================================================

# Application Environment (development | production | test)
NODE_ENV=development

# Database Connection URL (PostgreSQL single source of truth):
# Format: postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jansahaya?schema=public

# JWT Secret Key — MUST be a cryptographically strong 32+ character random string in production:
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Token Lifetime (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d

# Demo Mode — enables rapid hackathon role simulation (CITIZEN/SOLVER/INDUSTRY)
# IMPORTANT: ALWAYS SET TO "false" IN PRODUCTION DEPLOYMENTS!
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# Google Gemini API Key (Optional server-side key for multimodal audio and synthesis)
# Obtain from: https://aistudio.google.com/app/apikey
# If unset or unreachable, JanSahaya automatically uses its built-in deterministic NLP engine
GEMINI_API_KEY=

# CORS Allowed Origins — Comma-separated list of trusted origins (NEVER use wildcard * with credentials)
# Example: https://jansahaya.gov.in,https://admin.jansahaya.gov.in
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional Auxiliary Python/FastAPI Backend URL
FASTAPI_BACKEND_URL=http://localhost:8000

# PostgreSQL Container Credentials (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jansahaya
