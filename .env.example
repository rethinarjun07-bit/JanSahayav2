# =============================================================================
# JANSAHAYA V2 — PRODUCTION & VERCEL DEPLOYMENT CONFIGURATION TEMPLATE
# =============================================================================
# COPY THIS FILE TO .env.local FOR LOCAL DEVELOPMENT.
# NEVER COMMIT REAL SECRETS, API KEYS, OR CREDENTIALS TO THE REPOSITORY.
# IN PRODUCTION (VERCEL), CONFIGURE THESE IN VERCEL PROJECT ENVIRONMENT SETTINGS.
# =============================================================================

# Application Environment (production | development | test)
NODE_ENV=production

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL Single Source of Truth)
# -----------------------------------------------------------------------------
# Transaction Pooled Connection String (e.g. Supabase port 6543 / Neon / RDS):
DATABASE_URL=

# Direct Unpooled Connection String (Required for Prisma migrations with poolers):
DIRECT_URL=

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# JWT Secret Key — MUST be a cryptographically strong 32+ character random string in production:
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Token Lifetime (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d

# Demo Mode — rapid role simulation (CITIZEN/SOLVER/INDUSTRY)
# CRITICAL: ALWAYS SET BOTH TO "false" IN PRODUCTION DEPLOYMENTS!
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# -----------------------------------------------------------------------------
# AI Services & Webhooks
# -----------------------------------------------------------------------------
# Google Gemini API Key (Optional server-side key for multimodal audio and synthesis)
# Obtain from: https://aistudio.google.com/app/apikey
# If unset or unreachable, JanSahaya automatically uses its built-in deterministic NLP engine
GEMINI_API_KEY=

# SMS Gateway Ingestion Webhook Secret (Required for /api/ai/sms-parse)
# Generate with: openssl rand -hex 24
SMS_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Network & CORS Configuration
# -----------------------------------------------------------------------------
# CORS Allowed Origins — Comma-separated list of trusted origins (NEVER use wildcard * with credentials)
# Example: https://jansahaya.vercel.app,https://your-domain.gov.in
CORS_ORIGINS=

# Optional Auxiliary Python/FastAPI Backend URL (Leave empty if not deploying Python microservice)
FASTAPI_BACKEND_URL=

# -----------------------------------------------------------------------------
# Object Storage Configuration (Vercel Serverless Persistent Uploads)
# -----------------------------------------------------------------------------
# Storage Provider: "local" (default in dev), "s3" (Cloudflare R2 / AWS / Supabase), or "blob" (Vercel Blob)
STORAGE_PROVIDER=local

# Option A: S3 / Cloudflare R2 / Supabase S3-Compatible Storage
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Option B: Vercel Blob Storage (Auto-populated if Vercel Blob store is linked)
BLOB_READ_WRITE_TOKEN=
