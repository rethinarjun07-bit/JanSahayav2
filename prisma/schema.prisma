datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  password        String
  name            String
  role            String           @default("CITIZEN") // CITIZEN, SOLVER, INDUSTRY, ADMIN
  avatar          String?
  organization    String?
  designation     String?
  phone           String?
  district        String?
  state           String?
  bio             String?
  skills          String?          // JSON array of strings
  karmaPoints     Int              @default(100) @map("karma_points")
  badges          String?          // JSON array of badge objects
  isVerified      Boolean          @default(true) @map("is_verified")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  challenges      Challenge[]      @relation("CreatedChallenges")
  solutions       Solution[]       @relation("CreatedSolutions")
  reviews         Review[]
  comments        Comment[]
  upvotes         Upvote[]
  notifications   Notification[]
  auditLogs       AuditLog[]

  @@map("users")
}

model Challenge {
  id                          String           @id @default(cuid())
  title                       String
  description                 String
  category                    String           // Disaster Management, Water & Sanitation, Mining & Geology, Infrastructure, etc.
  severity                    String           @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  urgencyScore                Int              @default(50) @map("urgency_score") // 1-100
  status                      String           @default("SUBMITTED") // SUBMITTED, AI_ANALYZED, GOVERNMENT_REVIEW, VERIFIED, ASSIGNED, IN_PROGRESS, SOLVED, REJECTED, MERGED, ESCALATED
  latitude                    Float
  longitude                   Float
  address                     String
  district                    String
  state                       String
  pincode                     String?
  mediaUrls                   String?          @map("media_urls") // JSON array of strings
  audioUrl                    String?          @map("audio_url")
  voiceTranscript             String?          @map("voice_transcript")
  language                    String           @default("en")
  masterChallengeId           String?          @map("master_challenge_id")
  isMaster                    Boolean          @default(false) @map("is_master")
  duplicateScore              Float?           @map("duplicate_score")
  aiTags                      String?          @map("ai_tags") // JSON array of strings
  predictedSector             String?          @map("predicted_sector")
  autoAssignedUniversity      String?          @map("auto_assigned_university")
  officialNotes               String?          @map("official_notes")
  verifiedAt                  DateTime?        @map("verified_at")
  verifiedById                String?          @map("verified_by_id")
  assignedUniversityId        String?          @map("assigned_university_id")
  assignedDepartment          String?          @map("assigned_department")
  viewCount                   Int              @default(0) @map("view_count")
  confidenceScore             Int              @default(85) @map("confidence_score") // 0-100%
  duplicateProbability        Int              @default(0) @map("duplicate_probability") // 0-100%
  evidenceStrength            Int              @default(75) @map("evidence_strength") // 0-100%
  priorityScore               Int              @default(60) @map("priority_score") // 0-100%
  recommendedDepartment       String?          @map("recommended_department")
  slaDeadline                 DateTime?        @map("sla_deadline")
  slaStatus                   String           @default("ON_TRACK") @map("sla_status") // ON_TRACK, APPROACHING, BREACHED, ESCALATED, RESOLVED
  sdgGoals                    String?          @map("sdg_goals") // JSON array of UN SDG strings
  selectedSolutionId          String?          @map("selected_solution_id")
  citizenFeedback             String?          @map("citizen_feedback") // SOLVED, PARTIALLY_SOLVED, NOT_SOLVED
  citizenFeedbackNotes        String?          @map("citizen_feedback_notes")
  impactScore                 Int?             @map("impact_score") // 0-100
  beneficiariesCount          Int              @default(0) @map("beneficiaries_count")

  // Provenance Architecture (Citizen -> AI -> Government Official Decision)
  citizenReportedCategory     String?          @map("citizen_reported_category")
  citizenReportedSeverity     String?          @map("citizen_reported_severity")
  aiPredictedCategory         String?          @map("ai_predicted_category")
  aiPredictedSeverity         String?          @map("ai_predicted_severity")
  aiUrgencyScore              Int?             @map("ai_urgency_score")
  officialGovernmentCategory  String?          @map("official_government_category")
  officialGovernmentSeverity  String?          @map("official_government_severity")

  createdAt                   DateTime         @default(now()) @map("created_at")
  updatedAt                   DateTime         @updatedAt @map("updated_at")

  createdById                 String           @map("created_by_id")
  createdBy                   User             @relation("CreatedChallenges", fields: [createdById], references: [id], onDelete: Cascade)

  // Self relation for duplicate hierarchy
  masterChallenge             Challenge?       @relation("DuplicateHierarchy", fields: [masterChallengeId], references: [id])
  duplicates                  Challenge[]      @relation("DuplicateHierarchy")

  solutions                   Solution[]
  upvotes                     Upvote[]
  comments                    Comment[]

  @@index([status])
  @@index([category])
  @@index([district])
  @@index([createdById])
  @@index([createdAt])
  @@index([assignedUniversityId])
  @@map("challenges")
}

model DuplicateMerge {
  id                     String           @id @default(cuid())
  masterChallengeId      String           @map("master_challenge_id")
  duplicateChallengeId   String           @map("duplicate_challenge_id")
  similarityScore        Float            @map("similarity_score")
  reason                 String
  mergedById             String           @map("merged_by_id")
  mergedAt               DateTime         @default(now()) @map("merged_at")

  @@map("duplicate_merges")
}

model Solution {
  id                      String           @id @default(cuid())
  challengeId             String           @map("challenge_id")
  challenge               Challenge        @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  authorId                String           @map("author_id")
  author                  User             @relation("CreatedSolutions", fields: [authorId], references: [id], onDelete: Cascade)

  teamName                String?          @map("team_name")
  title                   String
  abstract                String
  methodology             String
  techStack               String?          @map("tech_stack") // JSON array of strings
  budgetEstimate          Float?           @map("budget_estimate")
  timelineMonths          Int?             @map("timeline_months")
  prototypeUrl            String?          @map("prototype_url")
  mediaUrls               String?          @map("media_urls") // JSON array of strings
  status                  String           @default("PROPOSED") // DRAFT, PROPOSED, MENTOR_REVIEW, PILOT_DEPLOYED, GOVT_VERIFIED, DEPLOYED
  milestoneStage          String           @default("Phase 1: Conceptualization") @map("milestone_stage")
  govtEndorsed            Boolean          @default(false) @map("govt_endorsed")
  endorsedBy              String?          @map("endorsed_by")
  endorsedAt              DateTime?        @map("endorsed_at")
  aiRecommendationVerdict String?          @map("ai_recommendation_verdict") // RECOMMENDED, FEASIBLE, ALTERNATIVE
  feasibilityScore        Float            @default(4.0) @map("feasibility_score")
  costEffectivenessScore  Float            @default(4.0) @map("cost_effectiveness_score")
  csrFundingStatus        String           @default("UNFUNDED") @map("csr_funding_status") // UNFUNDED, PLEDGED, FUNDED
  csrFunderName           String?          @map("csr_funder_name")
  csrAmountPledged        Float?           @map("csr_amount_pledged")
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")

  milestones              Milestone[]
  reviews                 Review[]
  upvotes                 Upvote[]
  comments                Comment[]

  @@index([challengeId])
  @@index([authorId])
  @@index([status])
  @@map("solutions")
}

model Milestone {
  id             String           @id @default(cuid())
  solutionId     String           @map("solution_id")
  solution       Solution         @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  order          Int
  title          String
  description    String
  targetDate     DateTime?        @map("target_date")
  status         String           @default("PENDING") // PENDING, SUBMITTED, APPROVED, REJECTED
  proofUrl       String?          @map("proof_url")
  notes          String?
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@map("milestones")
}

model Review {
  id                 String           @id @default(cuid())
  solutionId         String           @map("solution_id")
  solution           Solution         @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  reviewerId         String           @map("reviewer_id")
  reviewer           User             @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  role               String           // MENTOR, INDUSTRY, GOVT_NODAL
  rating             Float            // 1 to 5
  feasibilityScore   Float            @default(4.0) @map("feasibility_score")
  impactScore        Float            @default(4.0) @map("impact_score")
  costEffectiveness  Float            @default(4.0) @map("cost_effectiveness")
  scalabilityScore   Float            @default(4.0) @map("scalability_score")
  feedback           String
  createdAt          DateTime         @default(now()) @map("created_at")

  // Prevent duplicate reviews for the same proposal from the same reviewer
  @@unique([reviewerId, solutionId])
  @@map("reviews")
}

model Upvote {
  id             String           @id @default(cuid())
  userId         String           @map("user_id")
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId    String?          @map("challenge_id")
  challenge      Challenge?       @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  solutionId     String?          @map("solution_id")
  solution       Solution?        @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now()) @map("created_at")

  @@unique([userId, challengeId])
  @@unique([userId, solutionId])
  @@map("upvotes")
}

model Comment {
  id             String           @id @default(cuid())
  content        String
  userId         String           @map("user_id")
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId    String?          @map("challenge_id")
  challenge      Challenge?       @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  solutionId     String?          @map("solution_id")
  solution       Solution?        @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  audioUrl       String?          @map("audio_url")
  createdAt      DateTime         @default(now()) @map("created_at")

  @@map("comments")
}

model University {
  id                  String           @id @default(cuid())
  name                String
  code                String           @unique
  state               String
  district            String
  departments         String           // JSON array of strings
  expertiseTags       String           @map("expertise_tags") // JSON array of strings
  nodalOfficerName    String           @map("nodal_officer_name")
  nodalOfficerEmail   String           @map("nodal_officer_email")
  logoUrl             String?          @map("logo_url")

  @@map("universities")
}

model Notification {
  id             String           @id @default(cuid())
  userId         String           @map("user_id")
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  message        String
  type           String           @default("INFO") // INFO, SUCCESS, WARNING, BADGE_EARNED, DUPLICATE_ALERT
  link           String?
  isRead         Boolean          @default(false) @map("is_read")
  createdAt      DateTime         @default(now()) @map("created_at")

  @@map("notifications")
}

model AuditLog {
  id             String           @id @default(cuid())
  action         String
  entityType     String           @map("entity_type")
  entityId       String           @map("entity_id")
  actorId        String           @map("actor_id")
  user           User             @relation(fields: [actorId], references: [id], onDelete: Cascade)
  actorName      String           @map("actor_name")
  details        String?          // JSON
  createdAt      DateTime         @default(now()) @map("created_at")

  @@map("audit_logs")
}

model CivicCluster {
  id             String           @id @default(cuid())
  name           String
  category       String
  district       String
  latitude       Float
  longitude      Float
  radiusKm       Float            @default(2.5) @map("radius_km")
  reportCount    Int              @default(1) @map("report_count")
  urgencyScore   Int              @default(70) @map("urgency_score")
  challengeIds   String           @map("challenge_ids") // JSON array of challenge IDs
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@map("civic_clusters")
}
